# dsh-kit 环境变量模板
#
# 用法：复制为 custom/dsh-home/.env 并填入真实值。
# 注意：custom/dsh-home/.env 已被 gitignore，绝不会提交。
#
# 说明：
#   - dsh 会依次从 系统环境变量 → custom/dsh-home/.credentials.yaml → 启动目录 .env
#     → custom/dsh-home/.env 解析密钥（前一层已设置则不覆盖）。
#   - DEEPSEEK_BASE_URL 等 bootstrap 变量被 dsh 禁止写在 .env 里（见
#     packages/boot/app-boot/src/index.ts 的 BOOTSTRAP_NAMES），如需自定义端点
#     请在系统环境变量或 shell 配置文件中设置。
#   - 更推荐的方式：启动 Web UI 后在「设置 → 模型」页填写，密钥会安全写入
#     custom/dsh-home/.credentials.yaml（同样被 gitignore）。

DEEPSEEK_API_KEY=sk-你的密钥

# 以下按需取消注释并在 shell 环境里设置（不能放 .env）：
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DSH_MODEL=deepseek-chat
# DSH_TELEMETRY_MODE=off
